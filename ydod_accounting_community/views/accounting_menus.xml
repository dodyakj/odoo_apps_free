<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Top-level Accounting Root Menu -->
    <menuitem id="menu_finance_accounting"
              name="Accounting"
              web_icon="account,static/description/icon.png"
              groups="account.group_account_readonly,account.group_account_user,account.group_account_manager"
              sequence="50"/>

    <!-- Level 2: Accounting -->
    <menuitem id="menu_accounting_accounting"
              name="Accounting"
              parent="menu_finance_accounting"
              sequence="10"/>

    <menuitem id="menu_action_move_journal_line_community"
              name="Journal Entries"
              parent="menu_accounting_accounting"
              action="account.action_move_journal_line"
              sequence="1"/>

    <menuitem id="menu_action_account_moves_all_community"
              name="Journal Items"
              parent="menu_accounting_accounting"
              action="account.action_account_moves_all"
              sequence="2"/>

    <menuitem id="menu_action_manual_reconciliation_community"
              name="Manual Reconciliation"
              parent="menu_accounting_accounting"
              action="action_manual_reconciliation"
              sequence="3"/>

    <!-- Level 2: Reporting -->
    <menuitem id="menu_accounting_reporting"
              name="Reporting"
              parent="menu_finance_accounting"
              sequence="20"/>

    <menuitem id="menu_action_bank_reconcile_statement"
              name="Bank Reconciliation Statement"
              parent="menu_accounting_reporting"
              action="action_account_bank_reconcile_statement"
              sequence="1"/>

    <!-- Level 2: Configuration -->
    <menuitem id="menu_accounting_config"
              name="Configuration"
              parent="menu_finance_accounting"
              groups="account.group_account_manager"
              sequence="30"/>

    <menuitem id="menu_action_account_fiscal_year"
              name="Fiscal Years"
              parent="menu_accounting_config"
              action="action_account_fiscal_year"
              sequence="10"/>

    <!-- Shortcut under Invoicing > Configuration > Accounting -->
    <menuitem id="menu_account_fiscal_year_invoicing"
              name="Fiscal Years"
              parent="account.account_account_menu"
              action="action_account_fiscal_year"
              groups="account.group_account_manager"
              sequence="20"/>
</odoo>
