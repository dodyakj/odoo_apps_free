<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_ydod_accounting" model="ir.ui.view">
        <field name="name">res.company.form.inherit.ydod.accounting</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Accounting Setup" name="ydod_accounting_setup">
                    <group>
                        <group string="Fiscal Year Closing">
                            <field name="retained_earnings_account_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
