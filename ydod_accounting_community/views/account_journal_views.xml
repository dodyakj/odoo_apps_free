<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_tree_inherit_ydod" model="ir.ui.view">
        <field name="name">account.journal.list.inherit.ydod</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_account_id']" position="after">
                <button name="action_open_bank_reconcile_audit"
                        type="object"
                        string="Reconciliation Audit"
                        icon="fa-calculator"
                        title="Open Bank Reconciliation Audit Statement"
                        invisible="type != 'bank'"/>
            </xpath>
        </field>
    </record>
</odoo>
