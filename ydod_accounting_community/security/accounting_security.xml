<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_accounting_user" model="res.groups">
        <field name="name">Accountant (yDoD)</field>
        <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
    </record>

    <record id="group_accounting_manager" model="res.groups">
        <field name="name">Advisor / Manager (yDoD)</field>
        <field name="implied_ids" eval="[(4, ref('ydod_accounting_community.group_accounting_user')), (4, ref('account.group_account_manager'))]"/>
    </record>

    <!-- Multi-Company Record Rules -->
    <record id="account_fiscal_year_comp_rule" model="ir.rule">
        <field name="name">Account fiscal year multi-company</field>
        <field name="model_id" ref="model_account_fiscal_year"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <record id="ydod_fiscal_year_comp_rule" model="ir.rule">
        <field name="name">yDoD fiscal year multi-company</field>
        <field name="model_id" ref="model_ydod_fiscal_year"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <record id="ydod_account_asset_comp_rule" model="ir.rule">
        <field name="name">yDoD account asset multi-company</field>
        <field name="model_id" ref="model_ydod_account_asset"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <record id="ydod_account_asset_line_comp_rule" model="ir.rule">
        <field name="name">yDoD account asset line multi-company</field>
        <field name="model_id" ref="model_ydod_account_asset_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <record id="ydod_account_budget_comp_rule" model="ir.rule">
        <field name="name">yDoD account budget multi-company</field>
        <field name="model_id" ref="model_ydod_account_budget"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <record id="ydod_account_budget_line_comp_rule" model="ir.rule">
        <field name="name">yDoD account budget line multi-company</field>
        <field name="model_id" ref="model_ydod_account_budget_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
