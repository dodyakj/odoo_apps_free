<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_accounting_user" model="res.groups">
        <field name="name">Accountant (yDoD)</field>
        <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
    </record>

    <record id="group_accounting_manager" model="res.groups">
        <field name="name">Advisor / Manager (yDoD)</field>
        <field name="implied_ids" eval="[(4, ref('ydod_accounting_community.group_accounting_user')), (4, ref('account.group_account_manager'))]"/>
    </record>
</odoo>
