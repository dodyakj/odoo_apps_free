<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Action -->
    <record id="action_hr_announcement" model="ir.actions.act_window">
        <field name="name">Announcements</field>
        <field name="res_model">hr.announcement</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_hr_announcement_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first official announcement!
            </p>
            <p>
                Publish company-wide, department-level, or individual notices with automated read-receipt tracking and notifications.
            </p>
        </field>
    </record>

    <!-- Menus -->
    <menuitem
        id="menu_hr_announcement_root"
        name="Announcements"
        parent="hr.menu_hr_root"
        sequence="25"/>

    <menuitem
        id="menu_hr_announcement"
        name="All Announcements"
        parent="menu_hr_announcement_root"
        action="action_hr_announcement"
        sequence="1"/>

</odoo>
