<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_hr_announcement_manager" model="res.groups">
        <field name="name">HR Announcement Manager</field>
        <field name="category_id" ref="base.module_category_human_resources_employees"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="hr.group_hr_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_hr_announcement_manager'))]"/>
    </record>

    <!-- Multi-Company Record Rules -->
    <record id="rule_hr_announcement_company" model="ir.rule">
        <field name="name">HR Announcement: Multi-Company</field>
        <field name="model_id" ref="model_hr_announcement"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[
            '|',
            ('company_id', '=', False),
            ('company_id', 'in', company_ids)
        ]</field>
    </record>

    <record id="rule_hr_announcement_read_company" model="ir.rule">
        <field name="name">HR Announcement Read: Multi-Company</field>
        <field name="model_id" ref="model_hr_announcement_read"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[
            '|',
            ('company_id', '=', False),
            ('company_id', 'in', company_ids)
        ]</field>
    </record>

    <!-- Status Visibility Rules -->
    <record id="rule_hr_announcement_user_published" model="ir.rule">
        <field name="name">HR Announcement: Employees see published</field>
        <field name="model_id" ref="model_hr_announcement"/>
        <field name="domain_force">[('state', '=', 'published')]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_hr_announcement_manager_all" model="ir.rule">
        <field name="name">HR Announcement: Manager sees all</field>
        <field name="model_id" ref="model_hr_announcement"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_hr_announcement_manager'))]"/>
    </record>
</odoo>
