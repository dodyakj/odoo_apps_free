<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_hr_announcement_manager" model="res.groups">
        <field name="name">HR Announcement Manager</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="hr.group_hr_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_hr_announcement_manager'))]"/>
    </record>
</odoo>
