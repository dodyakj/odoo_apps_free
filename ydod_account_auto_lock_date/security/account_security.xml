<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_account_lock_date_bypass" model="res.groups">
        <field name="name">Bypass Accounting Lock Dates</field>
        <field name="comment">Allows authorized managers (Chief Accountants, Financial Controllers) to create, edit, and post journal entries in locked periods without removing the lock date for other users.</field>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <data noupdate="1">
        <record id="account_lock_date_audit_comp_rule" model="ir.rule">
            <field name="name">Account Lock Date Audit multi-company</field>
            <field name="model_id" ref="model_account_lock_date_audit"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
