<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcp_log_list" model="ir.ui.view">
        <field name="name">ydod.mcp.log.list</field>
        <field name="model">ydod.mcp.log</field>
        <field name="arch" type="xml">
            <tree string="Tool Call Log" create="0" edit="0">
                <field name="date"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="client_name" optional="show"/>
                <field name="jsonrpc_method"/>
                <field name="tool"/>
                <field name="model_name"/>
                <field name="duration_ms"/>
                <field name="status" widget="badge" decoration-success="status == 'success'"
                       decoration-danger="status == 'error'" decoration-warning="status in ('denied', 'rate_limited')"/>
                <field name="result_summary" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_mcp_log_form" model="ir.ui.view">
        <field name="name">ydod.mcp.log.form</field>
        <field name="model">ydod.mcp.log</field>
        <field name="arch" type="xml">
            <form string="Tool Call" create="0" edit="0">
                <header>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="jsonrpc_method"/></h1>
                    </div>
                    <group>
                        <group string="Call">
                            <field name="date"/>
                            <field name="tool"/>
                            <field name="model_name"/>
                            <field name="duration_ms"/>
                            <field name="result_summary"/>
                        </group>
                        <group string="Client">
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="api_key_id" groups="base.group_system"/>
                            <field name="client_name"/>
                            <field name="client_version"/>
                            <field name="session_id"/>
                        </group>
                    </group>
                    <group string="Arguments">
                        <field name="arguments" nolabel="1" colspan="2" class="font-monospace"/>
                    </group>
                    <group string="Error" invisible="not error_message">
                        <field name="error_message" nolabel="1" colspan="2" class="font-monospace text-danger"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mcp_log_search" model="ir.ui.view">
        <field name="name">ydod.mcp.log.search</field>
        <field name="model">ydod.mcp.log</field>
        <field name="arch" type="xml">
            <search string="Tool Call Log">
                <field name="user_id"/>
                <field name="tool"/>
                <field name="model_name"/>
                <field name="client_name"/>
                <field name="session_id"/>
                <filter name="errors" string="Errors" domain="[('status', '=', 'error')]"/>
                <filter name="denied" string="Denied" domain="[('status', '=', 'denied')]"/>
                <filter name="rate_limited" string="Rate limited" domain="[('status', '=', 'rate_limited')]"/>
                <separator/>
                <filter name="today" string="Today"
                        domain="[('date', '>=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="last_7_days" string="Last 7 days"
                        domain="[('date', '>=', (context_today() - relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_tool" string="Tool" context="{'group_by': 'tool'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_model" string="Model" context="{'group_by': 'model_name'}"/>
                    <filter name="group_client" string="Client" context="{'group_by': 'client_name'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mcp_log" model="ir.actions.act_window">
        <field name="name">Tool Call Log</field>
        <field name="res_model">ydod.mcp.log</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_last_7_days': 1, 'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No MCP tool call yet</p>
            <p>Every request an MCP client sends to /mcp is logged here with user, tool, arguments, duration and status.</p>
        </field>
    </record>
</odoo>
