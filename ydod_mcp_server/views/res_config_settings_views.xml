<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_mcp" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ydod.mcp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="MCP Server" string="MCP Server"
                     data-key="ydod_mcp_server" groups="base.group_system">
                    <h2>MCP Server</h2>
                    <div class="row mt16 o_settings_container" name="ydod_mcp_server_general">
                        <div class="col-12 col-lg-6 o_setting_box" id="ydod_mcp_enabled_setting">
                            <div class="o_setting_left_pane">
                                <field name="ydod_mcp_enabled"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="ydod_mcp_enabled"/>
                                <div class="text-muted">
                                    Global kill switch: when off, every MCP request is refused with a clear error.
                                </div>
                                <div class="content-group mt-2">
                                    <button name="%(action_mcp_model)d" type="action" string="Allowed Models"
                                            class="btn-link" icon="fa-arrow-right"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box" id="ydod_mcp_limits_setting">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Limits</span>
                                <div class="text-muted">
                                    Default rows per call, calls per minute per API key (0 = unlimited) and log retention (0 = keep forever).
                                </div>
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="ydod_mcp_default_limit" class="col-lg-6 o_light_label"/>
                                        <field name="ydod_mcp_default_limit" class="col-lg-3"/>
                                    </div>
                                    <div class="row">
                                        <label for="ydod_mcp_rate_limit" class="col-lg-6 o_light_label"/>
                                        <field name="ydod_mcp_rate_limit" class="col-lg-3"/>
                                    </div>
                                    <div class="row">
                                        <label for="ydod_mcp_log_retention_days" class="col-lg-6 o_light_label"/>
                                        <field name="ydod_mcp_log_retention_days" class="col-lg-3"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <h2>Connect an MCP Client</h2>
                    <div class="row mt16 o_settings_container" name="ydod_mcp_server_client">
                        <div class="col-12 col-lg-6 o_setting_box" id="ydod_mcp_endpoint_setting">
                            <div class="o_setting_right_pane">
                                <label for="ydod_mcp_endpoint_url"/>
                                <div class="text-muted">
                                    Use this URL with an Odoo API key (Preferences &gt; Account Security) as Bearer token.
                                </div>
                                <field name="ydod_mcp_endpoint_url" widget="CopyClipboardChar"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box" id="ydod_mcp_snippet_setting">
                            <div class="o_setting_right_pane">
                                <label for="ydod_mcp_client_snippet"/>
                                <div class="text-muted">
                                    Paste into Claude Desktop, Cursor or run in a terminal for Claude Code.
                                </div>
                                <field name="ydod_mcp_client_snippet" widget="CopyClipboardText" class="font-monospace"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="action_mcp_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'ydod_mcp_server', 'bin_size': False}</field>
    </record>
</odoo>
