<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_mcp_log_admin_company" model="ir.rule">
        <field name="name">MCP Tool Call Log: administrators see their companies</field>
        <field name="model_id" ref="model_ydod_mcp_log"/>
        <field name="groups" eval="[Command.link(ref('base.group_system'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_mcp_log_user_own" model="ir.rule">
        <field name="name">MCP Tool Call Log: users see their own calls</field>
        <field name="model_id" ref="model_ydod_mcp_log"/>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
