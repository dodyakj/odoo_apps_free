<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ydod_budget_view_list" model="ir.ui.view">
        <field name="name">ydod.budget.list</field>
        <field name="model">ydod.budget</field>
        <field name="arch" type="xml">
            <list string="Budgets" sample="1">
                <field name="name"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="planned_total" sum="Total Planned"/>
                <field name="theoretical_total" sum="Total Theoretical" optional="hide"/>
                <field name="actual_total" sum="Total Actual"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'" decoration-warning="state == 'confirm'"
                       decoration-success="state in ('validate', 'done')" decoration-muted="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="ydod_budget_view_form" model="ir.ui.view">
        <field name="name">ydod.budget.form</field>
        <field name="model">ydod.budget</field>
        <field name="arch" type="xml">
            <form string="Budget">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"
                            invisible="state != 'draft'" groups="ydod_account_budget.group_budget_manager"/>
                    <button name="action_validate" string="Validate" type="object" class="btn-primary"
                            invisible="state != 'confirm'" groups="ydod_account_budget.group_budget_manager"/>
                    <button name="action_done" string="Done" type="object" class="btn-primary"
                            invisible="state != 'validate'" groups="ydod_account_budget.group_budget_manager"/>
                    <button name="action_copy_next_period" string="Copy to Next Period" type="object"
                            invisible="state not in ('validate', 'done')" groups="ydod_account_budget.group_budget_manager"/>
                    <button name="action_refresh" string="Refresh" type="object" icon="fa-refresh"
                            invisible="state == 'cancel' or not id"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('done', 'cancel')" groups="ydod_account_budget.group_budget_manager"/>
                    <button name="action_draft" string="Reset to Draft" type="object"
                            invisible="state != 'cancel'" groups="ydod_account_budget.group_budget_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirm,validate,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_lines" type="object" class="oe_stat_button" icon="fa-list-ul"
                                invisible="not id">
                            <field name="line_count" widget="statinfo" string="Lines"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger" invisible="state != 'cancel'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. FY2027 Operating Budget" readonly="state != 'draft'"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id" widget="many2one_avatar_user" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="True"/>
                        </group>
                        <group>
                            <field name="date_from" readonly="state != 'draft'"/>
                            <field name="date_to" readonly="state != 'draft'"/>
                            <field name="planned_total"/>
                            <field name="theoretical_total"/>
                            <field name="actual_total"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Budget Lines" name="lines">
                            <field name="line_ids" readonly="state != 'draft'"
                                   context="{'default_date_from': date_from, 'default_date_to': date_to}">
                                <list editable="bottom" decoration-danger="is_over_budget"
                                      decoration-success="achievement_percent &gt;= 100 and planned_amount &gt; 0">
                                    <field name="company_id" column_invisible="True"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="state" column_invisible="True"/>
                                    <field name="is_over_budget" column_invisible="True"/>
                                    <field name="analytic_account_id"/>
                                    <field name="position_name"/>
                                    <field name="general_account_ids" widget="many2many_tags" optional="show"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="planned_amount" sum="Total Planned"/>
                                    <field name="theoretical_amount" sum="Total Theoretical"/>
                                    <field name="actual_amount" sum="Total Actual"/>
                                    <field name="achievement_percent" widget="progressbar"/>
                                    <button name="action_open_entries" type="object" icon="fa-search"
                                            title="View Entries" invisible="not id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Assumptions, approvals and comments..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="ydod_budget_view_search" model="ir.ui.view">
        <field name="name">ydod.budget.search</field>
        <field name="model">ydod.budget</field>
        <field name="arch" type="xml">
            <search string="Budgets">
                <field name="name"/>
                <field name="user_id"/>
                <field name="line_ids" string="Analytic Account"
                       filter_domain="[('line_ids.analytic_account_id', 'ilike', self)]"/>
                <filter string="My Budgets" name="my_budgets" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Validated" name="validated" domain="[('state', '=', 'validate')]"/>
                <separator/>
                <filter string="Current" name="current"
                        domain="[('date_from', '&lt;=', context_today().strftime('%Y-%m-%d')), ('date_to', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Responsible" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ydod_budget_view_pivot" model="ir.ui.view">
        <field name="name">ydod.budget.pivot</field>
        <field name="model">ydod.budget</field>
        <field name="arch" type="xml">
            <pivot string="Budgets" sample="1">
                <field name="date_from" interval="year" type="row"/>
                <field name="planned_total" type="measure"/>
                <field name="theoretical_total" type="measure"/>
                <field name="actual_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="ydod_budget_view_graph" model="ir.ui.view">
        <field name="name">ydod.budget.graph</field>
        <field name="model">ydod.budget</field>
        <field name="arch" type="xml">
            <graph string="Budgets" type="bar" stacked="0" sample="1">
                <field name="date_from" interval="year"/>
                <field name="planned_total" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_ydod_budget" model="ir.actions.act_window">
        <field name="name">Budgets</field>
        <field name="res_model">ydod.budget</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="ydod_budget_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first budget</p>
            <p>Plan amounts per analytic account and group of general accounts, then follow planned vs actual live.</p>
        </field>
    </record>
</odoo>
