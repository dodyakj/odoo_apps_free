<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_budget" model="res.groups.privilege">
        <field name="name">Budget</field>
        <field name="category_id" ref="base.module_category_accounting"/>
        <field name="sequence">60</field>
    </record>

    <!-- Budget users also get read-only accounting features so that the
         Accounting menus and the analytic items behind actual amounts are visible. -->
    <record id="group_budget_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="comment">Prepare draft budgets and follow planned vs actual amounts.</field>
        <field name="privilege_id" ref="res_groups_privilege_budget"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('account.group_account_readonly'))]"/>
    </record>

    <record id="group_budget_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="comment">Confirm, validate, close, cancel and copy budgets.</field>
        <field name="privilege_id" ref="res_groups_privilege_budget"/>
        <field name="implied_ids" eval="[(4, ref('group_budget_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
