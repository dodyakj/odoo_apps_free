    </record>
    <record id="demo_line_current_consulting" model="ydod.budget.line">
        <field name="budget_id" ref="demo_budget_current"/>
        <field name="analytic_account_id" ref="demo_analytic_sales"/>
        <field name="position_name">Consulting Revenue</field>
        <field name="general_account_ids" eval="[(6, 0, [ref('demo_account_consulting')])]"/>
        <field name="planned_amount">60000</field>
    </record>

    <!-- Budget lines: next year (draft, copy of the current year) -->
    <record id="demo_line_next_marketing" model="ydod.budget.line">
        <field name="budget_id" ref="demo_budget_next"/>
        <field name="analytic_account_id" ref="demo_analytic_sales"/>
        <field name="position_name">Marketing Expenses</field>
        <field name="general_account_ids" eval="[(6, 0, [ref('demo_account_marketing')])]"/>
        <field name="planned_amount">-24000</field>
    </record>
    <record id="demo_line_next_rent" model="ydod.budget.line">
        <field name="budget_id" ref="demo_budget_next"/>
        <field name="analytic_account_id" ref="demo_analytic_sales"/>
        <field name="position_name">Office Rent</field>
        <field name="general_account_ids" eval="[(6, 0, [ref('demo_account_rent')])]"/>
        <field name="planned_amount">-36000</field>
    </record>
    <record id="demo_line_next_consulting" model="ydod.budget.line">
        <field name="budget_id" ref="demo_budget_next"/>
        <field name="analytic_account_id" ref="demo_analytic_sales"/>
        <field name="position_name">Consulting Revenue</field>
        <field name="general_account_ids" eval="[(6, 0, [ref('demo_account_consulting')])]"/>
        <field name="planned_amount">60000</field>
    </record>

    <!-- Budget lines: previous year (done) -->
    <record id="demo_line_previous_marketing" model="ydod.budget.line">
        <field name="budget_id" ref="demo_budget_previous"/>
        <field name="analytic_account_id" ref="demo_analytic_sales"/>
        <field name="position_name">Marketing Expenses</field>
        <field name="general_account_ids" eval="[(6, 0, [ref('demo_account_marketing')])]"/>
        <field name="planned_amount">-20000</field>
    </record>
    <record id="demo_line_previous_rent" model="ydod.budget.line">
        <field name="budget_id" ref="demo_budget_previous"/>
        <field name="analytic_account_id" ref="demo_analytic_sales"/>
        <field name="position_name">Office Rent</field>
        <field name="general_account_ids" eval="[(6, 0, [ref('demo_account_rent')])]"/>
        <field name="planned_amount">-34000</field>
    </record>

    <!-- Budget lines: project and hiring plan -->
    <record id="demo_line_phoenix_costs" model="ydod.budget.line">
        <field name="budget_id" ref="demo_budget_phoenix"/>
        <field name="analytic_account_id" ref="demo_analytic_phoenix"/>
        <field name="position_name">Project Costs</field>
        <field name="planned_amount">-15000</field>
    </record>
    <record id="demo_line_hiring_recruitment" model="ydod.budget.line">
        <field name="budget_id" ref="demo_budget_hiring"/>
