<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_commission_line_rule_salesman" model="ir.rule">
        <field name="name">Commission Line: own records only</field>
        <field name="model_id" ref="model_sale_commission_line"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="sale_commission_line_rule_manager" model="ir.rule">
        <field name="name">Commission Line: full access for managers</field>
        <field name="model_id" ref="model_sale_commission_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
    </record>

</odoo>
