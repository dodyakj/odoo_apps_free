<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_inherit_commission" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.commission</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_commission_lines" type="object"
                        class="oe_stat_button" icon="fa-money" invisible="commission_count == 0">
                    <field name="commission_total" widget="monetary" string="Commission"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
