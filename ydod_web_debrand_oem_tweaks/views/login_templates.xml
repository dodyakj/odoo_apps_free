<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="login_layout_ydod_branding" inherit_id="web.login_layout" name="yDoD Login Footer Branding">
        <xpath expr="//a[contains(@href, 'utm_source=db')]" position="replace">
            <t t-set="ydod_branding" t-value="request.env['ir.http']._ydod_login_branding()"/>
            <a t-if="ydod_branding['mode'] == 'standard'" href="https://www.odoo.com?utm_source=db&amp;utm_medium=auth" target="_blank">Powered by <span>Odoo</span></a>
            <a t-elif="ydod_branding['mode'] == 'replace' and ydod_branding['url']" t-att-href="ydod_branding['url']" target="_blank" rel="noopener" t-out="ydod_branding['text']"/>
            <span t-elif="ydod_branding['mode'] == 'replace'" t-out="ydod_branding['text']"/>
        </xpath>
    </template>
</odoo>
