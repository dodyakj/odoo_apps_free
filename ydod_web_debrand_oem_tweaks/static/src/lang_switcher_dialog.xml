<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ydod_web_debrand_oem_tweaks.LangSwitcherDialog">
        <Dialog title="this.title" size="'sm'">
            <div t-if="this.state.loading" class="text-center text-muted p-3">
                <i class="fa fa-spinner fa-spin me-2"/>Loading languages&#8230;
            </div>
            <div t-else="" class="list-group">
                <t t-foreach="this.state.langs" t-as="lang" t-key="lang.code">
                    <button type="button"
                            t-attf-class="list-group-item list-group-item-action d-flex justify-content-between align-items-center {{ lang.code === this.currentLang ? 'active' : '' }}"
                            t-att-disabled="this.state.saving"
                            t-on-click="() => this.selectLang(lang.code)">
                        <span t-out="lang.name"/>
                        <i t-if="lang.code === this.currentLang" class="fa fa-check"/>
                    </button>
                </t>
            </div>
            <t t-set-slot="footer">
                <button type="button" class="btn btn-secondary" t-on-click="() => this.close()">Close</button>
            </t>
        </Dialog>
    </t>
</templates>
