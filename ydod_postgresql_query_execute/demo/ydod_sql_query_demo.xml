<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="demo_query_partner_count" model="ydod.sql.query">
        <field name="name">Demo: partner count</field>
        <field name="sql_text">SELECT count(*) AS partners FROM res_partner</field>
        <field name="orientation">portrait</field>
        <field name="note" type="html"><p>Counts every contact row, including archived ones. Read-only.</p></field>
        <field name="state">done</field>
        <field name="result_json" eval="{'columns': ['partners'], 'rows': [[42]], 'truncated': False}"/>
        <field name="row_count">1</field>
        <field name="duration_ms">1.84</field>
        <field name="last_run_date" eval="(DateTime.now() - timedelta(hours=3)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="last_run_user_id" ref="base.user_admin"/>
    </record>

    <record id="demo_query_touch_partner" model="ydod.sql.query">
        <field name="name">Demo: touch first partner</field>
        <field name="sql_text">UPDATE res_partner SET write_date = write_date WHERE id = (SELECT min(id) FROM res_partner)</field>
        <field name="allow_write" eval="True"/>
        <field name="orientation">portrait</field>
        <field name="note" type="html"><p>Harmless UPDATE used to demonstrate the <strong>Allow data modification</strong> guard. Affects exactly one row.</p></field>
        <field name="state">done</field>
        <field name="row_count">1</field>
        <field name="duration_ms">2.31</field>
        <field name="last_run_date" eval="(DateTime.now() - timedelta(hours=2)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="last_run_user_id" ref="base.user_admin"/>
    </record>

    <record id="demo_query_typo" model="ydod.sql.query">
        <field name="name">Demo: query with a typo</field>
        <field name="sql_text">SELECT id, login FROM res_user ORDER BY id</field>
        <field name="orientation">portrait</field>
        <field name="note" type="html"><p>The table is named res_users: this query shows how PostgreSQL errors are reported in the Result tab.</p></field>
        <field name="state">error</field>
        <field name="error_message">relation "res_user" does not exist
LINE 1: SELECT id, login FROM res_user ORDER BY id
                              ^</field>
        <field name="duration_ms">0.42</field>
        <field name="last_run_date" eval="(DateTime.now() - timedelta(hours=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="last_run_user_id" ref="base.user_admin"/>
    </record>

    <record id="demo_query_companies" model="ydod.sql.query">
        <field name="name">Demo: companies and currencies</field>
        <field name="sql_text">SELECT c.id, c.name, cur.name AS currency
FROM res_company c
JOIN res_currency cur ON cur.id = c.currency_id
ORDER BY c.id</field>
        <field name="orientation">landscape</field>
        <field name="max_rows">50</field>
        <field name="note" type="html"><p>Lists companies with their currency. Not executed yet: click Execute to see the result.</p></field>
    </record>

    <record id="demo_history_partner_count_1" model="ydod.sql.query.history">
        <field name="query_id" ref="demo_query_partner_count"/>
        <field name="name">Demo: partner count</field>
        <field name="sql_text">SELECT count(*) AS partners FROM res_partner</field>
        <field name="user_id" ref="base.user_admin"/>
        <field name="run_date" eval="(DateTime.now() - timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="duration_ms">2.05</field>
        <field name="row_count">1</field>
        <field name="state">done</field>
    </record>

    <record id="demo_history_partner_count_2" model="ydod.sql.query.history">
        <field name="query_id" ref="demo_query_partner_count"/>
        <field name="name">Demo: partner count</field>
        <field name="sql_text">SELECT count(*) AS partners FROM res_partner</field>
        <field name="user_id" ref="base.user_admin"/>
        <field name="run_date" eval="(DateTime.now() - timedelta(hours=3)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="duration_ms">1.84</field>
        <field name="row_count">1</field>
        <field name="state">done</field>
    </record>

    <record id="demo_history_touch_partner" model="ydod.sql.query.history">
        <field name="query_id" ref="demo_query_touch_partner"/>
        <field name="name">Demo: touch first partner</field>
        <field name="sql_text">UPDATE res_partner SET write_date = write_date WHERE id = (SELECT min(id) FROM res_partner)</field>
        <field name="user_id" ref="base.user_admin"/>
        <field name="run_date" eval="(DateTime.now() - timedelta(hours=2)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="duration_ms">2.31</field>
        <field name="row_count">1</field>
        <field name="is_write" eval="True"/>
        <field name="state">done</field>
    </record>

    <record id="demo_history_typo" model="ydod.sql.query.history">
        <field name="query_id" ref="demo_query_typo"/>
        <field name="name">Demo: query with a typo</field>
        <field name="sql_text">SELECT id, login FROM res_user ORDER BY id</field>
        <field name="user_id" ref="base.user_admin"/>
        <field name="run_date" eval="(DateTime.now() - timedelta(hours=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="duration_ms">0.42</field>
        <field name="row_count">0</field>
        <field name="state">error</field>
        <field name="error_message">relation "res_user" does not exist</field>
    </record>

    <record id="demo_history_deleted_query" model="ydod.sql.query.history">
        <field name="name">Ad-hoc: count attachments</field>
        <field name="sql_text">SELECT count(*) AS attachments FROM ir_attachment</field>
        <field name="user_id" ref="base.user_admin"/>
        <field name="run_date" eval="(DateTime.now() - timedelta(days=2)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="duration_ms">3.17</field>
        <field name="row_count">1</field>
        <field name="state">done</field>
    </record>

</odoo>
