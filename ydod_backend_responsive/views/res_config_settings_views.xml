<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_ydod_responsive" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ydod.responsive</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="20"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Responsive UI" id="ydod_backend_responsive" string="Responsive UI" data-key="ydod_backend_responsive">
                    <h2>Mobile &amp; Responsive Layout</h2>
                    <div class="row mt16 o_settings_container" id="ydod_responsive_settings_block">
                        <div class="col-12 col-lg-6 o_setting_box" id="ydod_default_chatter_position_setting">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Default Chatter Position</span>
                                <div class="text-muted">
                                    Configure the default chatter placement for new users (sided or bottom-stacked).
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="ydod_default_chatter_position"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box" id="ydod_enable_mobile_bottombar_setting">
                            <div class="o_setting_left_pane">
                                <field name="ydod_enable_mobile_bottombar"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="ydod_enable_mobile_bottombar"/>
                                <div class="text-muted">
                                    Enable adaptive bottom navigation bar on mobile viewports for one-thumb access.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="action_ydod_responsive_config_settings" model="ir.actions.act_window">
        <field name="name">Responsive Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'ydod_backend_responsive'}</field>
    </record>
</odoo>
