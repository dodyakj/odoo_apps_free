<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.x2many.line.search</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='general_settings']" position="inside">
                <div id="ydod_x2many_line_search">
                    <h2>X2Many Lists</h2>
                    <div class="row mt16 o_settings_container" name="x2many_line_search_setting_container">
                        <div class="col-12 col-lg-6 o_setting_box" id="x2many_line_search_setting">
                            <div class="o_setting_left_pane">
                                <field name="x2many_line_search_enabled"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="x2many_line_search_enabled"/>
                                <div class="text-muted">
                                    Show an instant search box with highlight and match counter above every one2many / many2many list in form views. Reload the browser to apply.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
