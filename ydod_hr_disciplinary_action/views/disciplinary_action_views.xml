<odoo>
    <!-- List View -->
    <record id="view_disciplinary_action_list" model="ir.ui.view">
        <field name="name">ydod.disciplinary.action.list</field>
        <field name="model">ydod.disciplinary.action</field>
        <field name="arch" type="xml">
            <list string="Disciplinary Actions" decoration-danger="severity == 'critical'" decoration-warning="severity == 'high'" decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="department_id"/>
                <field name="action_type"/>
                <field name="severity"/>
                <field name="incident_date"/>
                <field name="expiration_date"/>
                <field name="state" widget="badge" decoration-success="state == 'confirmed'" decoration-info="state == 'draft'" decoration-warning="state == 'submitted'" decoration-muted="state in ('expired', 'cancelled')"/>
            </list>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_disciplinary_action_kanban" model="ir.ui.view">
        <field name="name">ydod.disciplinary.action.kanban</field>
        <field name="model">ydod.disciplinary.action</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_mobile">
                <templates>
                    <t t-name="card">
                        <div class="row g-0">
                            <div class="col-2">
                                <field name="employee_id" widget="image" class="o_kanban_image rounded-circle"/>
                            </div>
                            <div class="col-10 ps-2">
                                <div class="d-flex justify-content-between align-items-center">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    <field name="severity" widget="badge" decoration-danger="severity == 'critical'" decoration-warning="severity == 'high'"/>
                                </div>
                                <div class="text-muted"><field name="employee_id"/></div>
                                <div class="text-muted small"><field name="subject"/></div>
                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <span class="badge bg-secondary"><field name="action_type"/></span>
                                    <field name="incident_date"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_disciplinary_action_form" model="ir.ui.view">
        <field name="name">ydod.disciplinary.action.form</field>
        <field name="model">ydod.disciplinary.action</field>
        <field name="arch" type="xml">
            <form string="Disciplinary Action">
                <header>
                    <button name="action_submit" string="Submit for Review" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_confirm" string="Confirm Warning" type="object" class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_expire" string="Mark as Expired" type="object" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('cancelled', 'expired')"/>
                    <button name="action_draft" string="Reset to Draft" type="object" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" widget="many2one_avatar_employee" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="department_id"/>
                            <field name="job_id"/>
                            <field name="manager_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="action_type" readonly="state != 'draft'"/>
                            <field name="severity" readonly="state != 'draft'"/>
                            <field name="incident_date" readonly="state != 'draft'"/>
                            <field name="expiration_date" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Incident &amp; Details" name="details">
                            <group>
                                <field name="subject" readonly="state != 'draft'"/>
                            </group>
                            <label for="description" string="Incident Details &amp; Findings"/>
                            <field name="description" readonly="state != 'draft'"/>
                        </page>
                        <page string="Corrective Actions &amp; Remarks" name="corrective">
                            <label for="corrective_action" string="Required Corrective Actions"/>
                            <field name="corrective_action" readonly="state != 'draft'"/>
                            <label for="employee_remarks" string="Employee Remarks / Defense"/>
                            <field name="employee_remarks" placeholder="Enter any comments or statements provided by the employee..." readonly="state != 'draft'"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_disciplinary_action_search" model="ir.ui.view">
        <field name="name">ydod.disciplinary.action.search</field>
        <field name="model">ydod.disciplinary.action</field>
        <field name="arch" type="xml">
            <search string="Search Disciplinary Actions">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="subject"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Pending Review" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Confirmed Active" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Expired" name="expired" domain="[('state', '=', 'expired')]"/>
                <separator/>
                <filter string="Verbal Warning" name="verbal" domain="[('action_type', '=', 'verbal')]"/>
                <filter string="Written Warning" name="written" domain="[('action_type', '=', 'written')]"/>
                <filter string="Final Warning" name="final" domain="[('action_type', '=', 'final')]"/>
                <filter string="Suspension" name="suspension" domain="[('action_type', '=', 'suspension')]"/>
                <filter string="Termination" name="termination" domain="[('action_type', '=', 'termination')]"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Department" name="group_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Action Type" name="group_action_type" context="{'group_by': 'action_type'}"/>
                    <filter string="Severity" name="group_severity" context="{'group_by': 'severity'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Incident Date" name="group_incident_date" context="{'group_by': 'incident_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action Definition -->
    <record id="action_disciplinary_action" model="ir.actions.act_window">
        <field name="name">Disciplinary Actions</field>
        <field name="res_model">ydod.disciplinary.action</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_disciplinary_action_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record your first employee disciplinary action
            </p>
            <p>
                Manage employee misconduct, formal warnings, incident reports, and corrective actions in a secure workflow.
            </p>
        </field>
    </record>

    <!-- Menuitem -->
    <menuitem id="menu_disciplinary_root"
              name="Disciplinary Actions"
              parent="hr.menu_hr_root"
              sequence="95"/>

    <menuitem id="menu_disciplinary_action"
              name="Disciplinary Records"
              parent="menu_disciplinary_root"
              action="action_disciplinary_action"
              sequence="10"/>
</odoo>
