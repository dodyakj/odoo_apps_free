<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Contacts who agreed to WhatsApp contact -->
    <record id="base.res_partner_1" model="res.partner">
        <field name="whatsapp_opt_in" eval="True"/>
    </record>
    <record id="base.res_partner_2" model="res.partner">
        <field name="whatsapp_opt_in" eval="True"/>
    </record>
    <record id="base.res_partner_3" model="res.partner">
        <field name="whatsapp_opt_in" eval="True"/>
    </record>
    <record id="base.res_partner_12" model="res.partner">
        <field name="whatsapp_opt_in" eval="True"/>
    </record>

    <!-- Sessions -->
    <record id="demo_session_sales" model="openwa.session">
        <field name="name">Sales Jakarta</field>
        <field name="remote_id">sales-jakarta</field>
        <field name="status">connected</field>
        <field name="phone_number">6281234500001</field>
        <field name="dedicated_number_confirmed" eval="True"/>
        <field name="last_status_at" eval="(DateTime.now() - timedelta(hours=2)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_admin'))]"/>
    </record>
    <record id="demo_session_care" model="openwa.session">
        <field name="name">Customer Care Surabaya</field>
        <field name="remote_id">care-surabaya</field>
        <field name="status">connected</field>
        <field name="phone_number">6281234500002</field>
        <field name="dedicated_number_confirmed" eval="True"/>
        <field name="min_delay_seconds">12</field>
        <field name="hourly_cap">40</field>
        <field name="user_ids" eval="[Command.link(ref('base.user_admin'))]"/>
    </record>
    <record id="demo_session_marketing" model="openwa.session">
        <field name="name">Marketing Bandung</field>
        <field name="remote_id">marketing-bandung</field>
        <field name="status">disconnected</field>
        <field name="phone_number">6281234500003</field>
        <field name="dedicated_number_confirmed" eval="True"/>
        <field name="hourly_cap">30</field>
    </record>
    <record id="demo_session_branch" model="openwa.session">
        <field name="name">New Branch Medan</field>
        <field name="status">disconnected</field>
        <field name="last_error">The OpenWA base URL is not configured (Settings &gt; WhatsApp).</field>
    </record>

    <!-- Message log -->
    <record id="demo_message_1" model="openwa.message">
        <field name="direction">out</field>
        <field name="session_id" ref="demo_session_sales"/>
        <field name="partner_id" ref="base.res_partner_1"/>
        <field name="wa_number">628123450101@c.us</field>
        <field name="body">Hello, your quotation for 20 office chairs is ready. Shall we schedule delivery next week?</field>
        <field name="openwa_message_id">true_628123450101@c.us_3EB0A1</field>
        <field name="status">read</field>
        <field name="sent_at" eval="(DateTime.now() - timedelta(hours=3)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="delivered_at" eval="(DateTime.now() - timedelta(hours=3)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="read_at" eval="(DateTime.now() - timedelta(hours=2)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
    <record id="demo_message_2" model="openwa.message">
        <field name="direction">in</field>
        <field name="session_id" ref="demo_session_sales"/>
        <field name="partner_id" ref="base.res_partner_1"/>
        <field name="wa_number">628123450101@c.us</field>
        <field name="body">Yes please, Tuesday morning works for us. Thank you!</field>
        <field name="openwa_message_id">false_628123450101@c.us_3EB0A2</field>
        <field name="status">received</field>
    </record>
    <record id="demo_message_3" model="openwa.message">
        <field name="direction">out</field>
        <field name="session_id" ref="demo_session_care"/>
        <field name="partner_id" ref="base.res_partner_2"/>
        <field name="wa_number">628123450102@c.us</field>
        <field name="body">Your support ticket has been resolved. Please find the service report attached.</field>
        <field name="attachment_name">service_report.pdf</field>
        <field name="openwa_message_id">true_628123450102@c.us_3EB0B1</field>
        <field name="status">delivered</field>
        <field name="sent_at" eval="(DateTime.now() - timedelta(hours=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="delivered_at" eval="(DateTime.now() - timedelta(minutes=50)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
    <record id="demo_message_4" model="openwa.message">
        <field name="direction">out</field>
        <field name="session_id" ref="demo_session_care"/>
        <field name="partner_id" ref="base.res_partner_3"/>
        <field name="wa_number">628123450103@c.us</field>
        <field name="body">Reminder: your annual maintenance visit is planned for Friday at 10:00.</field>
        <field name="openwa_message_id">true_628123450103@c.us_3EB0C1</field>
        <field name="status">sent</field>
        <field name="sent_at" eval="(DateTime.now() - timedelta(minutes=20)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
    <record id="demo_message_5" model="openwa.message">
        <field name="direction">out</field>
        <field name="session_id" ref="demo_session_sales"/>
        <field name="partner_id" ref="base.res_partner_4"/>
        <field name="wa_number">628123450104@c.us</field>
        <field name="body">Hi, we have a new price list for 2026. May I send it to you?</field>
        <field name="status">failed</field>
        <field name="error">OpenWA request /api/messages/send-text failed: timed out</field>
    </record>
    <record id="demo_message_6" model="openwa.message">
        <field name="direction">in</field>
        <field name="session_id" ref="demo_session_care"/>
        <field name="wa_number">6285700011122@c.us</field>
        <field name="body">Hello, I saw your shop on Instagram. Do you deliver to Bandung?</field>
        <field name="openwa_message_id">false_6285700011122@c.us_3EB0D1</field>
        <field name="status">received</field>
    </record>
    <record id="demo_message_7" model="openwa.message">
        <field name="direction">out</field>
        <field name="session_id" ref="demo_session_sales"/>
        <field name="partner_id" ref="base.res_partner_12"/>
        <field name="wa_number">628123450112@c.us</field>
        <field name="body">Thank you for your order! Your invoice will follow by email.</field>
        <field name="openwa_message_id">true_628123450112@c.us_3EB0E1</field>
        <field name="status">read</field>
        <field name="sent_at" eval="(DateTime.now() - timedelta(minutes=30)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="read_at" eval="(DateTime.now() - timedelta(minutes=10)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>

    <!-- WhatsApp conversations in Discuss -->
    <record id="demo_channel_wood_corner" model="discuss.channel">
        <field name="name">WhatsApp: Wood Corner</field>
        <field name="channel_type">group</field>
        <field name="openwa_session_id" ref="demo_session_sales"/>
        <field name="openwa_wa_number">628123450101@c.us</field>
        <field name="openwa_partner_id" ref="base.res_partner_1"/>
        <field name="channel_member_ids" eval="[Command.create({'partner_id': ref('base.partner_admin')})]"/>
    </record>
    <record id="demo_channel_unknown" model="discuss.channel">
        <field name="name">WhatsApp: +6285700011122</field>
        <field name="channel_type">group</field>
        <field name="openwa_session_id" ref="demo_session_care"/>
        <field name="openwa_wa_number">6285700011122@c.us</field>
        <field name="channel_member_ids" eval="[Command.create({'partner_id': ref('base.partner_admin')})]"/>
    </record>
    <record id="demo_message_2" model="openwa.message">
        <field name="res_model">discuss.channel</field>
        <field name="res_id" ref="demo_channel_wood_corner"/>
    </record>
    <record id="demo_message_6" model="openwa.message">
        <field name="res_model">discuss.channel</field>
        <field name="res_id" ref="demo_channel_unknown"/>
    </record>

    <record id="demo_chat_1" model="mail.message">
        <field name="model">discuss.channel</field>
        <field name="res_id" ref="demo_channel_wood_corner"/>
        <field name="message_type">comment</field>
        <field name="subtype_id" ref="mail.mt_comment"/>
        <field name="author_id" ref="base.partner_admin"/>
        <field name="body">Hello, your quotation for 20 office chairs is ready. Shall we schedule delivery next week?</field>
        <field name="date" eval="(DateTime.now() - timedelta(hours=3)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
    <record id="demo_chat_2" model="mail.message">
        <field name="model">discuss.channel</field>
        <field name="res_id" ref="demo_channel_wood_corner"/>
        <field name="message_type">comment</field>
        <field name="subtype_id" ref="mail.mt_comment"/>
        <field name="author_id" ref="base.res_partner_1"/>
        <field name="body">Yes please, Tuesday morning works for us. Thank you!</field>
        <field name="date" eval="(DateTime.now() - timedelta(hours=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
    <record id="demo_chat_3" model="mail.message">
        <field name="model">discuss.channel</field>
        <field name="res_id" ref="demo_channel_unknown"/>
        <field name="message_type">comment</field>
        <field name="subtype_id" ref="mail.mt_comment"/>
        <field name="author_id" eval="False"/>
        <field name="email_from">WhatsApp +6285700011122</field>
        <field name="body">Hello, I saw your shop on Instagram. Do you deliver to Bandung?</field>
        <field name="date" eval="(DateTime.now() - timedelta(minutes=15)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
</odoo>
