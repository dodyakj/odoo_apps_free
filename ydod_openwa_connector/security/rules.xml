<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_openwa_session_company" model="ir.rule">
        <field name="name">OpenWA Session: multi-company</field>
        <field name="model_id" ref="model_openwa_session"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_openwa_message_user" model="ir.rule">
        <field name="name">OpenWA Message: own messages</field>
        <field name="model_id" ref="model_openwa_message"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_openwa_user'))]"/>
    </record>

    <record id="rule_openwa_message_manager" model="ir.rule">
        <field name="name">OpenWA Message: company messages</field>
        <field name="model_id" ref="model_openwa_message"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('group_openwa_manager'))]"/>
    </record>
</odoo>
