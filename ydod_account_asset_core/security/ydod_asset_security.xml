<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ydod_asset_comp_rule" model="ir.rule">
        <field name="name">Assets multi-company</field>
        <field name="model_id" ref="model_ydod_asset"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="ydod_asset_category_comp_rule" model="ir.rule">
        <field name="name">Asset categories multi-company</field>
        <field name="model_id" ref="model_ydod_asset_category"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
