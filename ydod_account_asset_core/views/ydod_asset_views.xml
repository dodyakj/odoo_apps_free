<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ydod_asset_list" model="ir.ui.view">
        <field name="name">ydod.asset.list</field>
        <field name="model">ydod.asset</field>
        <field name="arch" type="xml">
            <list string="Assets" decoration-muted="state == 'closed'">
                <field name="name"/>
                <field name="category_id"/>
                <field name="acquisition_date"/>
                <field name="partner_id" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="original_value" sum="Total"/>
                <field name="depreciated_value" sum="Total"/>
                <field name="book_value" sum="Total"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'"
                       decoration-success="state == 'running'"/>
            </list>
        </field>
    </record>

    <record id="view_ydod_asset_form" model="ir.ui.view">
        <field name="name">ydod.asset.form</field>
        <field name="model">ydod.asset</field>
        <field name="arch" type="xml">
            <form string="Asset">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"
                            invisible="state != 'draft'" groups="account.group_account_manager"/>
                    <button name="action_dispose" string="Dispose" type="object" invisible="state != 'running'"
                            groups="account.group_account_manager"
                            confirm="Post the write-off of the remaining book value and close this asset?"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                            invisible="state != 'running'" groups="account.group_account_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,running,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_moves" type="object" class="oe_stat_button" icon="fa-bars"
                                invisible="not move_count">
                            <field name="move_count" widget="statinfo" string="Journal Entries"/>
                        </button>
                        <button name="action_view_schedule" type="object" class="oe_stat_button" icon="fa-calendar"
                                invisible="not depreciation_move_ids">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Depreciation</span>
                                <span class="o_stat_text">Schedule</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Closed" bg_color="text-bg-secondary" invisible="state != 'closed'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Toyota Avanza 1.5 G" readonly="state == 'closed'"/></h1>
                    </div>
                    <group>
                        <group string="Values" name="values">
                            <field name="currency_id" invisible="1"/>
                            <field name="original_value" readonly="state != 'draft'"/>
                            <field name="salvage_value" readonly="state != 'draft'"/>
                            <field name="already_depreciated" readonly="state != 'draft'"/>
                            <field name="depreciable_base"/>
                            <field name="depreciated_value"/>
                            <field name="book_value" class="fw-bold"/>
                        </group>
                        <group string="Depreciation" name="depreciation">
                            <field name="category_id" readonly="state != 'draft'"/>
                            <field name="acquisition_date" readonly="state != 'draft'"/>
                            <field name="first_depreciation_date" readonly="state != 'draft'"/>
                            <label for="method_number"/>
                            <div class="o_row">
                                <field name="method_number" readonly="state != 'draft'"/>
                                <field name="method_period" readonly="state != 'draft'"/>
                            </div>
                            <field name="prorata" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Schedule" name="schedule">
                            <field name="depreciation_move_ids" readonly="1">
                                <list create="0" delete="0" decoration-muted="state == 'posted'">
                                    <field name="company_currency_id" column_invisible="1"/>
                                    <field name="date"/>
                                    <field name="ref"/>
                                    <field name="name" optional="hide"/>
                                    <field name="asset_depreciation_amount" sum="Total"/>
                                    <field name="asset_cumulative_depreciation"/>
                                    <field name="asset_remaining_value"/>
                                    <field name="state" widget="badge" decoration-success="state == 'posted'"
                                           decoration-info="state == 'draft'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Source &amp; Disposal" name="source">
                            <group>
                                <group string="Source" name="source_info">
                                    <field name="partner_id" readonly="state == 'closed'"/>
                                    <field name="invoice_id"/>
                                    <field name="invoice_line_id" invisible="not invoice_line_id"/>
                                </group>
                                <group string="Disposal" name="disposal" invisible="state == 'draft'">
                                    <field name="disposal_date" readonly="state != 'running'"/>
                                    <field name="disposal_account_id" readonly="state != 'running'"/>
                                    <field name="disposal_move_id" invisible="not disposal_move_id"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ydod_asset_search" model="ir.ui.view">
        <field name="name">ydod.asset.search</field>
        <field name="model">ydod.asset</field>
        <field name="arch" type="xml">
            <search string="Assets">
                <field name="name"/>
                <field name="category_id"/>
                <field name="partner_id"/>
                <field name="invoice_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Running" name="running" domain="[('state', '=', 'running')]"/>
                <filter string="Closed" name="closed" domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter string="Acquired This Year" name="this_year"
                        domain="[('acquisition_date', '&gt;=', (context_today() + relativedelta(month=1, day=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="From Vendor Bills" name="from_bill" domain="[('invoice_id', '!=', False)]"/>
                <group>
                    <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Acquisition Year" name="group_year" context="{'group_by': 'acquisition_date:year'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_ydod_asset_pivot" model="ir.ui.view">
        <field name="name">ydod.asset.pivot</field>
        <field name="model">ydod.asset</field>
        <field name="arch" type="xml">
            <pivot string="Asset Register" sample="1">
                <field name="category_id" type="row"/>
                <field name="state" type="col"/>
                <field name="original_value" type="measure"/>
                <field name="depreciated_value" type="measure"/>
                <field name="book_value" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_ydod_asset" model="ir.actions.act_window">
        <field name="name">Assets</field>
        <field name="res_model">ydod.asset</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register your first fixed asset</p>
            <p>Assets are also created automatically when a vendor bill is posted on the fixed asset account of a category.</p>
        </field>
    </record>

    <record id="action_ydod_asset_register" model="ir.actions.act_window">
        <field name="name">Asset Register</field>
        <field name="res_model">ydod.asset</field>
        <field name="view_mode">pivot,list,form</field>
        <field name="context">{'search_default_group_year': 1}</field>
    </record>
</odoo>
