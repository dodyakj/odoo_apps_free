<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_ydod_asset" model="ir.ui.view">
        <field name="name">account.move.form.ydod.asset</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_source_assets" type="object" class="oe_stat_button" icon="fa-building"
                        attrs="{'invisible': [('source_asset_count', '=', 0)]}"
                        groups="account.group_account_user,account.group_account_manager">
                    <field name="source_asset_count" widget="statinfo" string="Assets"/>
                </button>
                <button name="action_open_asset" type="object" class="oe_stat_button" icon="fa-building-o"
                        attrs="{'invisible': [('asset_id', '=', False)]}"
                        groups="account.group_account_user,account.group_account_manager">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Asset</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='tax_cash_basis_origin_move_id']" position="before">
                <field name="asset_id" attrs="{'invisible': [('asset_id', '=', False)]}"
                       groups="account.group_account_user,account.group_account_manager"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_list_asset_schedule" model="ir.ui.view">
        <field name="name">account.move.list.ydod.asset.schedule</field>
        <field name="model">account.move</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <tree string="Depreciation Schedule" create="0" decoration-muted="state == 'posted'">
                <field name="company_currency_id" invisible="1"/>
                <field name="date"/>
                <field name="name"/>
                <field name="asset_id"/>
                <field name="ref"/>
                <field name="journal_id" optional="hide"/>
                <field name="asset_depreciation_amount" sum="Total"/>
                <field name="asset_cumulative_depreciation"/>
                <field name="asset_remaining_value"/>
                <field name="state" widget="badge" decoration-success="state == 'posted'"
                       decoration-info="state == 'draft'"/>
            </tree>
        </field>
    </record>

    <record id="action_ydod_depreciation_entries" model="ir.actions.act_window">
        <field name="name">Depreciation Entries</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_move_list_asset_schedule"/>
        <field name="domain">[('asset_id', '!=', False)]</field>
        <field name="context">{'create': False}</field>
    </record>
</odoo>
