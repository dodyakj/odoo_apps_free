<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- logs follow the company the job ran as -->
        <record id="cron_task_log_rule_company" model="ir.rule">
            <field name="name">Cron Task Log: multi-company</field>
            <field name="model_id" ref="model_cron_task_log"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
