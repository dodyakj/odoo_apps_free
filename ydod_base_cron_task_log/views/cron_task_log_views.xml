<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_task_log_view_list" model="ir.ui.view">
        <field name="name">cron.task.log.list</field>
        <field name="model">cron.task.log</field>
        <field name="arch" type="xml">
            <list string="Cron Task Logs" create="0" edit="0"
                  decoration-danger="status in ('failed', 'timeout')"
                  decoration-info="status == 'running'"
                  decoration-muted="status == 'skipped'">
                <field name="date_start"/>
                <field name="cron_id"/>
                <field name="trigger_type"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'success'"
                       decoration-danger="status in ('failed', 'timeout')"
                       decoration-info="status == 'running'"
                       decoration-muted="status == 'skipped'"/>
                <field name="duration" sum="Total"/>
                <field name="record_count" sum="Total"/>
                <field name="error_summary" optional="show"/>
                <field name="user_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="cron_task_log_view_form" model="ir.ui.view">
        <field name="name">cron.task.log.form</field>
        <field name="model">cron.task.log</field>
        <field name="arch" type="xml">
            <form string="Cron Task Log" create="0" edit="0">
                <header>
                    <button name="action_rerun" type="object" string="Re-run now" class="oe_highlight"
                            icon="fa-repeat" invisible="status not in ('failed', 'timeout')"
                            confirm="Run this scheduled action again now?"/>
                    <button name="action_open_cron" type="object" string="Open Scheduled Action"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="cron_id"/>
                        <h1><field name="cron_id"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="status" widget="badge"
                                   decoration-success="status == 'success'"
                                   decoration-danger="status in ('failed', 'timeout')"
                                   decoration-info="status == 'running'"/>
                            <field name="trigger_type"/>
                            <field name="error_summary" invisible="not error_summary"/>
                            <field name="rerun_of_id" invisible="not rerun_of_id"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="duration"/>
                            <field name="record_count"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Traceback" name="traceback" invisible="not traceback">
                            <field name="traceback" nolabel="1" class="font-monospace small"/>
                        </page>
                        <page string="Message" name="message">
                            <field name="message" nolabel="1" placeholder="Notes reported by log_progress()"/>
                        </page>
                        <page string="Re-runs" name="reruns" invisible="not rerun_ids">
                            <field name="rerun_ids" nolabel="1">
                                <list>
                                    <field name="date_start"/>
                                    <field name="trigger_type"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'success'"
                                           decoration-danger="status in ('failed', 'timeout')"/>
                                    <field name="duration"/>
                                    <field name="error_summary"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="cron_task_log_view_search" model="ir.ui.view">
        <field name="name">cron.task.log.search</field>
        <field name="model">cron.task.log</field>
        <field name="arch" type="xml">
            <search string="Cron Task Logs">
                <field name="cron_id"/>
                <field name="error_summary"/>
                <field name="user_id"/>
                <filter string="Failed (last 24 hours)" name="failed_24h"
                        domain="[('status', 'in', ('failed', 'timeout')), ('date_start', '>=', (datetime.datetime.now() - relativedelta(hours=24)).to_utc().strftime('%Y-%m-%d %H:%M:%S'))]"/>
                <filter string="Failed" name="failed" domain="[('status', '=', 'failed')]"/>
                <filter string="Timeouts" name="timeouts" domain="[('status', '=', 'timeout')]"/>
                <filter string="Running" name="running" domain="[('status', '=', 'running')]"/>
                <separator/>
                <filter string="Manual runs" name="manual" domain="[('trigger_type', '=', 'manual')]"/>
                <separator/>
                <filter string="Today" name="today"
                        domain="[('date_start', '>=', datetime.datetime.combine(context_today(), datetime.time(0, 0, 0)).to_utc().strftime('%Y-%m-%d %H:%M:%S'))]"/>
                <filter string="Start Date" name="filter_date_start" date="date_start"/>
                <group>
                    <filter string="Scheduled Action" name="group_cron" context="{'group_by': 'cron_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                    <filter string="Day" name="group_day" context="{'group_by': 'date_start:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cron_task_log" model="ir.actions.act_window">
        <field name="name">Cron Task Logs</field>
        <field name="res_model">cron.task.log</field>
        <field name="path">cron-task-logs</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="cron_task_log_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No scheduled action has run yet</p>
            <p>Every execution of a Scheduled Action, automatic or manual, is recorded here
                with its status, duration and traceback.</p>
        </field>
    </record>
</odoo>
