<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_approvals" model="res.groups.privilege">
        <field name="name">Approvals</field>
        <field name="description">Configure approval rules and decide any approval request.</field>
    </record>

    <record id="group_approval_manager" model="res.groups">
        <field name="name">Approval Manager</field>
        <field name="privilege_id" ref="privilege_approvals"/>
        <field name="comment">Configures approval rules and can approve, reject or cancel every approval request.</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="implied_by_ids" eval="[Command.link(ref('base.group_system'))]"/>
    </record>
</odoo>
