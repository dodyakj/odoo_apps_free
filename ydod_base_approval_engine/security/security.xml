<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_approvals" model="ir.module.category">
        <field name="name">Approvals</field>
        <field name="description">Configure approval rules and decide any approval request.</field>
        <field name="sequence">60</field>
    </record>

    <record id="group_approval_manager" model="res.groups">
        <field name="name">Approval Manager</field>
        <field name="category_id" ref="privilege_approvals"/>
        <field name="comment">Configures approval rules and can approve, reject or cancel every approval request.</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_approval_manager'))]"/>
    </record>

    <!-- Requests: users see their own requests and those assigned to them -->
    <record id="rule_request_user" model="ir.rule">
        <field name="name">Approval request: requester or approver</field>
        <field name="model_id" ref="model_ydod_approval_request"/>
        <field name="domain_force">['|', '|', ('requester_id', '=', user.id), ('approver_user_ids', 'in', [user.id]), ('approver_group_id', 'in', user.groups_id.ids)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
    <record id="rule_request_manager" model="ir.rule">
        <field name="name">Approval request: manager sees all</field>
        <field name="model_id" ref="model_ydod_approval_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_approval_manager'))]"/>
    </record>

    <!-- Multi-company isolation -->
    <record id="rule_rule_company" model="ir.rule">
        <field name="name">Approval rule: multi-company</field>
        <field name="model_id" ref="model_ydod_approval_rule"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_request_company" model="ir.rule">
        <field name="name">Approval request: multi-company</field>
        <field name="model_id" ref="model_ydod_approval_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
