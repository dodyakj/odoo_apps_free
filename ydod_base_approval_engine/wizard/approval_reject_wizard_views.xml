<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_approval_reject_wizard_form" model="ir.ui.view">
        <field name="name">ydod.approval.reject.wizard.form</field>
        <field name="model">ydod.approval.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Approval">
                <group>
                    <field name="request_ids" widget="many2many_tags" readonly="1"/>
                    <field name="reason" placeholder="Explain why the document is rejected and what must change..."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Reject" class="btn-danger" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
