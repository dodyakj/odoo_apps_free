<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_contact_document_notify_wizard_form" model="ir.ui.view">
        <field name="name">contact.document.notify.wizard.form</field>
        <field name="model">contact_document_notify_wizard</field>
        <field name="arch" type="xml">
            <form string="Send Compliance Notification">
                <sheet>
                    <group>
                        <field name="document_ids" widget="many2many_tags" readonly="1"/>
                    </group>
                    <group>
                        <field name="message" widget="text" nolabel="1" placeholder="Enter message to send..." colspan="2"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Send Notification" type="object" name="action_send_notification" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
