<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_contact_document_type_form" model="ir.ui.view">
        <field name="name">contact.document.type.form</field>
        <field name="model">contact_document_type</field>
        <field name="arch" type="xml">
            <form string="Document Type">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="alert_days"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
