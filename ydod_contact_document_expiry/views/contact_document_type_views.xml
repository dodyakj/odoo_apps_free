<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_contact_document_type_list" model="ir.ui.view">
        <field name="name">contact.document.type.list</field>
        <field name="model">contact_document_type</field>
        <field name="arch" type="xml">
            <list string="Document Types" editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="alert_days"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_contact_document_type" model="ir.actions.act_window">
        <field name="name">Document Types</field>
        <field name="res_model">contact_document_type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define document classifications.
            </p>
        </field>
    </record>
</odoo>
