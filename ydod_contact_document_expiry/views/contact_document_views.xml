<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_contact_document_list" model="ir.ui.view">
        <field name="name">contact.document.list</field>
        <field name="model">contact_document</field>
        <field name="arch" type="xml">
            <list string="Compliance Documents" decoration-danger="state == 'expired'" decoration-warning="state == 'expiring'" decoration-success="state == 'valid'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="document_type_id"/>
                <field name="document_number"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
                <field name="days_to_expiry"/>
                <field name="state" widget="badge" decoration-danger="state == 'expired'" decoration-warning="state == 'expiring'" decoration-success="state == 'valid'"/>
            </list>
        </field>
    </record>

    <record id="view_contact_document_form" model="ir.ui.view">
        <field name="name">contact.document.form</field>
        <field name="model">contact_document</field>
        <field name="arch" type="xml">
            <form string="Compliance Document">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="valid,expiring,expired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. ISO 9001 Certificate 2024"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="document_type_id"/>
                            <field name="document_number"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="days_to_expiry"/>
                            <field name="alert_days"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Attachments &amp; Files" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" widget="html"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_contact_document_kanban" model="ir.ui.view">
        <field name="name">contact.document.kanban</field>
        <field name="model">contact_document</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <templates>
                    <t t-name="card">
                        <div class="row">
                            <div class="col-8">
                                <strong class="o_kanban_record_title"><t t-out="record.name.value"/></strong>
                                <div class="text-muted"><t t-out="record.partner_id.value"/></div>
                            </div>
                            <div class="col-4 text-end">
                                <field name="state" widget="badge" decoration-danger="state == 'expired'" decoration-warning="state == 'expiring'" decoration-success="state == 'valid'"/>
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-12 text-muted">
                                <span>Type: <t t-out="record.document_type_id.value"/></span><br/>
                                <span>Expires: <t t-out="record.expiry_date.value"/></span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_contact_document_search" model="ir.ui.view">
        <field name="name">contact.document.search</field>
        <field name="model">contact_document</field>
        <field name="arch" type="xml">
            <search string="Search Compliance Documents">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="document_number"/>
                <field name="document_type_id"/>
                <separator/>
                <filter string="Valid" name="filter_valid" domain="[('state', '=', 'valid')]"/>
                <filter string="Expiring Soon" name="filter_expiring" domain="[('state', '=', 'expiring')]"/>
                <filter string="Expired" name="filter_expired" domain="[('state', '=', 'expired')]"/>
                <separator/>
                <filter string="Expiring in 30 Days" name="filter_30_days" domain="[('days_to_expiry', '&gt;=', 0), ('days_to_expiry', '&lt;=', 30)]"/>
                <filter string="Expiring in 60 Days" name="filter_60_days" domain="[('days_to_expiry', '&gt;=', 0), ('days_to_expiry', '&lt;=', 60)]"/>
                <filter string="Expiring in 90 Days" name="filter_90_days" domain="[('days_to_expiry', '&gt;=', 0), ('days_to_expiry', '&lt;=', 90)]"/>
                <group expand="0" string="Group By">
                    <filter string="Contact" name="group_by_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Document Type" name="group_by_type" context="{'group_by': 'document_type_id'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Expiry Date" name="group_by_expiry" context="{'group_by': 'expiry_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_contact_document" model="ir.actions.act_window">
        <field name="name">Compliance Documents</field>
        <field name="res_model">contact_document</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_contact_document_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register your first contact compliance document!
            </p>
            <p>
                Keep track of vendor trade licenses, customer insurance policies, identity cards, and certifications with automated alerts.
            </p>
        </field>
    </record>

    <record id="action_contact_document_notify" model="ir.actions.act_window">
        <field name="name">Send Notification</field>
        <field name="res_model">contact_document_notify_wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_contact_document"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
