<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="task_type_edit_inherit_stage_duration" model="ir.ui.view">
        <field name="name">project.task.type.form.inherit.stage.duration</field>
        <field name="model">project.task.type</field>
        <field name="inherit_id" ref="project.task_type_edit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='mail_template_id']" position="after">
                <label for="max_duration_hours" string="Max Stage Duration" invisible="user_id"/>
                <div class="o_row" invisible="user_id">
                    <field name="max_duration_hours" class="oe_inline"/>
                    <span>hours (0 = unlimited)</span>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
