<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_backup_user" model="res.groups">
        <field name="name">Backup / User</field>
        <field name="comment">Read-only audit access to backup configurations and execution history logs.</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_backup_manager" model="res.groups">
        <field name="name">Backup / Manager</field>
        <field name="comment">Full administrative access to backup configurations, credentials, execution logs, and manual backup execution.</field>
        <field name="implied_ids" eval="[Command.link(ref('group_backup_user')), Command.link(ref('base.group_system'))]"/>
        <field name="users" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>
</odoo>
