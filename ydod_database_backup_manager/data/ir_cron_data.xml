<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_backup_scheduler_action" model="ir.cron">
            <field name="name">Database Backup: Scheduled Execution</field>
            <field name="model_id" ref="ydod_database_backup_manager.model_ydod_backup_config"/>
            <field name="state">code</field>
            <field name="code">model.cron_run_backups()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
