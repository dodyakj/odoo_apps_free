<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ydod_crm_competitor_view_search" model="ir.ui.view">
        <field name="name">ydod.crm.competitor.view.search</field>
        <field name="model">ydod.crm.competitor</field>
        <field name="arch" type="xml">
            <search string="Search Competitors">
                <field name="name"/>
                <field name="website"/>
                <filter string="Active" name="filter_active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="ydod_crm_competitor_view_form" model="ir.ui.view">
        <field name="name">ydod.crm.competitor.view.form</field>
        <field name="model">ydod.crm.competitor</field>
        <field name="arch" type="xml">
            <form string="Competitor">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_opportunities" type="object"
                            class="oe_stat_button" icon="fa-trophy">
                            <div class="o_stat_info">
                                <field name="opportunity_count" class="o_stat_value"/>
                                <span class="o_stat_text">Opportunities</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Acme Corp"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="website" widget="url" placeholder="https://..."/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="won_count"/>
                            <field name="lost_count"/>
                            <field name="win_rate" widget="percentage"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Strengths, weaknesses, pricing, talking points..."/>
                        </page>
                        <page string="Win/Loss History" name="history">
                            <field name="result_ids" readonly="1">
                                <list>
                                    <field name="close_date"/>
                                    <field name="lead_id"/>
                                    <field name="result"/>
                                    <field name="stage_id"/>
                                    <field name="expected_revenue" widget="monetary" options="{'currency_field': 'company_currency'}"/>
                                    <field name="company_currency" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="ydod_crm_competitor_view_list" model="ir.ui.view">
        <field name="name">ydod.crm.competitor.view.list</field>
        <field name="model">ydod.crm.competitor</field>
        <field name="arch" type="xml">
            <list string="Competitors">
                <field name="name"/>
                <field name="website"/>
                <field name="opportunity_count" string="Opportunities"/>
                <field name="won_count"/>
                <field name="lost_count"/>
                <field name="win_rate" widget="percentage"/>
            </list>
        </field>
    </record>

    <record id="ydod_crm_competitor_action" model="ir.actions.act_window">
        <field name="name">Competitors</field>
        <field name="res_model">ydod.crm.competitor</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="ydod_crm_competitor_view_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Create a Competitor
          </p><p>
            Track the competitors you regularly face on opportunities and build data-backed battle cards.
          </p>
        </field>
    </record>

</odoo>
