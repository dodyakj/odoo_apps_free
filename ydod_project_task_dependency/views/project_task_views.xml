<odoo>
    <record id="view_task_form_inherit_dependency" model="ir.ui.view">
        <field name="name">project.task.form.inherit.dependency</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0 text-center" role="alert" invisible="not is_blocked or state in ('1_done', '1_canceled')">
                    <i class="fa fa-lock me-2"/>
                    This task is currently <strong>blocked</strong> by one or more predecessor tasks.
                </div>
            </xpath>

            <xpath expr="//sheet" position="inside">
                <field name="is_blocked" invisible="1"/>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_predecessors" type="object" class="oe_stat_button" icon="fa-level-up" invisible="blocked_count == 0">
                    <field name="blocked_count" widget="statinfo" string="Predecessors"/>
                </button>
                <button name="action_view_successors" type="object" class="oe_stat_button" icon="fa-level-down" invisible="blocking_count == 0">
                    <field name="blocking_count" widget="statinfo" string="Successors"/>
                </button>
            </xpath>

            <xpath expr="//page[@name='description_page']" position="after">
                <page name="dependencies" string="Dependencies">
                    <group>
                        <group string="Predecessors (Must finish first)">
                            <field name="predecessor_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="user_ids" widget="many2many_tags" optional="show"/>
                                    <field name="date_deadline" optional="show"/>
                                    <field name="state" widget="badge" 
                                           decoration-success="state == '1_done'" 
                                           decoration-info="state == '01_in_progress'"
                                           decoration-muted="state == '1_canceled'"/>
                                </list>
                            </field>
                        </group>
                        <group string="Successors (Waiting for this task)">
                            <field name="successor_ids" nolabel="1" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="user_ids" widget="many2many_tags" optional="show"/>
                                    <field name="state" widget="badge" 
                                           decoration-success="state == '1_done'" 
                                           decoration-info="state == '01_in_progress'"
                                           decoration-muted="state == '1_canceled'"/>
                                </list>
                            </field>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_task_search_form_inherit_dependency" model="ir.ui.view">
        <field name="name">project.task.search.inherit.dependency</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_tasks']" position="after">
                <filter string="Blocked Tasks" name="blocked_tasks" domain="[('is_blocked', '=', True), ('state', 'not in', ('1_done', '1_canceled'))]"/>
                <filter string="Ready Tasks" name="ready_tasks" domain="[('is_blocked', '=', False), ('state', 'not in', ('1_done', '1_canceled'))]"/>
            </xpath>
        </field>
    </record>
</odoo>
