<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_price_deviation_wizard_view_form" model="ir.ui.view">
        <field name="name">purchase.price.deviation.wizard.form</field>
        <field name="model">purchase.price.deviation.wizard</field>
        <field name="arch" type="xml">
            <form string="Approve Price Deviation">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        The lines below are priced above their reference price by more than the allowed tolerance.
                        Approving confirms the order(s) and logs your justification in the chatter.
                    </div>
                    <group>
                        <field name="order_ids" widget="many2many_tags" readonly="1"/>
                    </group>
                    <field name="line_ids" readonly="1" nolabel="1">
                        <list>
                            <field name="order_id"/>
                            <field name="product_id"/>
                            <field name="product_qty"/>
                            <field name="price_reference"/>
                            <field name="price_unit_discounted" string="New Price"/>
                            <field name="price_deviation_rate" widget="percentage" decoration-danger="1"/>
                            <field name="price_reference_source" optional="hide"/>
                        </list>
                    </field>
                    <group>
                        <field name="justification" placeholder="e.g. Vendor raised steel prices by 18%; no cheaper alternative available this month."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_approve" type="object" string="Approve &amp; Confirm" class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
