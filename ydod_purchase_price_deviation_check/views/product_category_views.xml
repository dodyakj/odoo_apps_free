<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_category_view_form_price_deviation" model="ir.ui.view">
        <field name="name">product.category.form.inherit.price.deviation</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group name="price_deviation" string="Purchase Price Tolerance">
                    <field name="price_deviation_override" widget="boolean_toggle"/>
                    <field name="price_deviation_tolerance" invisible="not price_deviation_override"/>
                    <field name="price_deviation_tolerance_amount" invisible="not price_deviation_override"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
