<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_menu_access" model="res.groups.privilege">
        <field name="name">Menu Access Control</field>
        <field name="sequence">60</field>
        <field name="category_id" ref="base.module_category_administration"/>
    </record>

    <record id="group_menu_access_manager" model="res.groups">
        <field name="name">Menu Access Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_menu_access"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Can create, edit and delete menu restrictions for the companies they belong to. Does not bypass menu hiding.</field>
    </record>

    <!-- Menu Access Managers only see and manage the restrictions of their own companies. -->
    <record id="rule_ydod_menu_access_manager_company" model="ir.rule">
        <field name="name">Menu Restriction: manager limited to own companies</field>
        <field name="model_id" ref="model_ydod_menu_access"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        <field name="groups" eval="[Command.link(ref('group_menu_access_manager'))]"/>
    </record>

    <!-- System administrators manage every restriction, whatever the company. -->
    <record id="rule_ydod_menu_access_system_all" model="ir.rule">
        <field name="name">Menu Restriction: administrators manage all</field>
        <field name="model_id" ref="model_ydod_menu_access"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_system'))]"/>
    </record>
</odoo>
