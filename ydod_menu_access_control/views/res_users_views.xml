<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_inherit_ydod_menu_access" model="ir.ui.view">
        <field name="name">res.users.form.inherit.ydod.menu.access</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_ydod_view_menu_access" type="object" class="oe_stat_button" icon="fa-eye-slash"
                        groups="ydod_menu_access_control.group_menu_access_manager,base.group_system"
                        attrs="{'invisible': ['|', ('id', '=', False), ('share', '=', True)]}">
                    <field string="Hidden Menus" name="ydod_menu_access_count" widget="statinfo"/>
                </button>
            </div>
            <page name="access_rights" position="after">
                <page string="Menu Restrictions" name="ydod_menu_restrictions"
                      attrs="{'invisible': [('share', '=', True)]}"
                      groups="ydod_menu_access_control.group_menu_access_manager,base.group_system">
                    <div class="mb-3">
                        <button name="action_ydod_open_copy_wizard" type="object" string="Copy Hidden Menus"
                                class="btn btn-secondary" icon="fa-clone"
                                attrs="{'invisible': [('id', '=', False)]}"/>
                    </div>
                    <field name="ydod_menu_access_ids">
                        <tree editable="bottom">
                            <field name="menu_id" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            <field name="cascade" readonly="1"/>
                        </tree>
                    </field>
                </page>
            </page>
        </field>
    </record>
</odoo>
