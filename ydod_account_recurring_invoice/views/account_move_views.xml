<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_recurring" model="ir.ui.view">
        <field name="name">account.move.form.inherit.recurring</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_recurring_schedule"
                        type="object"
                        string="Create Recurrence"
                        class="btn-secondary"
                        invisible="move_type not in ('out_invoice', 'in_invoice') or state != 'posted' or recurring_id"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_recurring_schedule"
                        class="oe_stat_button"
                        icon="fa-refresh"
                        type="object"
                        invisible="not recurring_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Recurring</span>
                        <span class="o_stat_text">Schedule</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="recurring_id" invisible="not recurring_id" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
