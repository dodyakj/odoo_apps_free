<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="demo_orderpoint_chair" model="stock.warehouse.orderpoint">
        <field name="product_id" ref="product.product_product_12"/>
        <field name="warehouse_id" ref="stock.warehouse0"/>
        <field name="location_id" ref="stock.stock_location_stock"/>
        <field name="product_min_qty">10.0</field>
        <field name="product_max_qty">50.0</field>
        <field name="trigger">manual</field>
        <field name="require_approval" eval="True"/>
        <field name="responsible_buyer_id" ref="base.user_admin"/>
    </record>

    <record id="demo_orderpoint_storage_box" model="stock.warehouse.orderpoint">
        <field name="product_id" ref="product.product_product_7"/>
        <field name="warehouse_id" ref="stock.warehouse0"/>
        <field name="location_id" ref="stock.stock_location_stock"/>
        <field name="product_min_qty">20.0</field>
        <field name="product_max_qty">100.0</field>
        <field name="trigger">manual</field>
        <field name="require_approval" eval="True"/>
        <field name="responsible_buyer_id" ref="base.user_demo"/>
    </record>

    <record id="demo_orderpoint_desk_organizer" model="stock.warehouse.orderpoint">
        <field name="product_id" ref="product.desk_pad"/>
        <field name="warehouse_id" ref="stock.warehouse0"/>
        <field name="location_id" ref="stock.stock_location_stock"/>
        <field name="product_min_qty">15.0</field>
        <field name="product_max_qty">60.0</field>
        <field name="trigger">manual</field>
        <field name="require_approval" eval="True"/>
        <field name="responsible_buyer_id" ref="base.user_admin"/>
    </record>

    <record id="demo_orderpoint_monitor_stand" model="stock.warehouse.orderpoint">
        <field name="product_id" ref="product.monitor_stand"/>
        <field name="warehouse_id" ref="stock.warehouse0"/>
        <field name="location_id" ref="stock.stock_location_stock"/>
        <field name="product_min_qty">25.0</field>
        <field name="product_max_qty">80.0</field>
        <field name="trigger">manual</field>
        <field name="require_approval" eval="True"/>
        <field name="responsible_buyer_id" ref="base.user_demo"/>
    </record>

    <record id="demo_orderpoint_cabinet" model="stock.warehouse.orderpoint">
        <field name="product_id" ref="product.product_product_6"/>
        <field name="warehouse_id" ref="stock.warehouse0"/>
        <field name="location_id" ref="stock.stock_location_stock"/>
        <field name="product_min_qty">5.0</field>
        <field name="product_max_qty">20.0</field>
        <field name="trigger">manual</field>
        <field name="require_approval" eval="True"/>
        <field name="responsible_buyer_id" ref="base.user_admin"/>
    </record>

    <record id="demo_orderpoint_sofa" model="stock.warehouse.orderpoint">
        <field name="product_id" ref="product.consu_delivery_01"/>
        <field name="warehouse_id" ref="stock.warehouse0"/>
        <field name="location_id" ref="stock.stock_location_stock"/>
        <field name="product_min_qty">3.0</field>
        <field name="product_max_qty">10.0</field>
        <field name="trigger">manual</field>
        <field name="require_approval" eval="True"/>
        <field name="responsible_buyer_id" ref="base.user_demo"/>
    </record>

    <record id="demo_request_chair_pending" model="ydod.replenish.request">
        <field name="orderpoint_id" ref="demo_orderpoint_chair"/>
        <field name="product_qty">40.0</field>
        <field name="state">pending</field>
        <field name="request_date" eval="(DateTime.today() - relativedelta(days=1)).strftime('%Y-%m-%d 09:00:00')"/>
    </record>

    <record id="demo_request_storage_box_pending" model="ydod.replenish.request">
        <field name="orderpoint_id" ref="demo_orderpoint_storage_box"/>
        <field name="product_qty">80.0</field>
        <field name="state">pending</field>
        <field name="request_date" eval="DateTime.today().strftime('%Y-%m-%d 08:30:00')"/>
    </record>

    <record id="demo_request_desk_organizer_approved" model="ydod.replenish.request">
        <field name="orderpoint_id" ref="demo_orderpoint_desk_organizer"/>
        <field name="product_qty">45.0</field>
        <field name="state">approved</field>
        <field name="request_date" eval="(DateTime.today() - relativedelta(days=5)).strftime('%Y-%m-%d 10:15:00')"/>
        <field name="decision_date" eval="(DateTime.today() - relativedelta(days=4)).strftime('%Y-%m-%d 11:00:00')"/>
        <field name="decided_by" ref="base.user_admin"/>
    </record>

    <record id="demo_request_monitor_stand_rejected" model="ydod.replenish.request">
        <field name="orderpoint_id" ref="demo_orderpoint_monitor_stand"/>
        <field name="product_qty">55.0</field>
        <field name="state">rejected</field>
        <field name="request_date" eval="(DateTime.today() - relativedelta(days=6)).strftime('%Y-%m-%d 14:20:00')"/>
        <field name="decision_date" eval="(DateTime.today() - relativedelta(days=5)).strftime('%Y-%m-%d 09:45:00')"/>
        <field name="decided_by" ref="base.user_demo"/>
        <field name="reject_reason">Budget frozen until next quarter review.</field>
    </record>

    <record id="demo_request_cabinet_pending" model="ydod.replenish.request">
        <field name="orderpoint_id" ref="demo_orderpoint_cabinet"/>
        <field name="product_qty">15.0</field>
        <field name="state">pending</field>
        <field name="request_date" eval="(DateTime.today() - relativedelta(hours=3)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>

    <record id="demo_request_sofa_approved" model="ydod.replenish.request">
        <field name="orderpoint_id" ref="demo_orderpoint_sofa"/>
        <field name="product_qty">7.0</field>
        <field name="state">approved</field>
        <field name="request_date" eval="(DateTime.today() - relativedelta(days=10)).strftime('%Y-%m-%d 16:00:00')"/>
        <field name="decision_date" eval="(DateTime.today() - relativedelta(days=9)).strftime('%Y-%m-%d 08:10:00')"/>
        <field name="decided_by" ref="base.user_admin"/>
    </record>

    <record id="demo_request_chair_rejected_history" model="ydod.replenish.request">
        <field name="orderpoint_id" ref="demo_orderpoint_chair"/>
        <field name="product_qty">30.0</field>
        <field name="state">rejected</field>
        <field name="request_date" eval="(DateTime.today() - relativedelta(days=20)).strftime('%Y-%m-%d 13:00:00')"/>
        <field name="decision_date" eval="(DateTime.today() - relativedelta(days=19)).strftime('%Y-%m-%d 09:30:00')"/>
        <field name="decided_by" ref="base.user_admin"/>
        <field name="reject_reason">Vendor lead time too long, sourcing an alternative supplier first.</field>
    </record>
</odoo>
