<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_inherit_min_order" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.min.order</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <field name="meets_minimums" invisible="1"/>
                <field name="meets_min_amount" invisible="1"/>
                <field name="meets_min_quantity" invisible="1"/>
                <div class="alert alert-warning mb-2" role="alert" invisible="meets_minimums or state in ('purchase', 'done', 'cancel') or not partner_id">
                    <div class="d-flex align-items-center">
                        <i class="fa fa-exclamation-triangle fa-2x me-3 text-warning"/>
                        <div class="flex-grow-1">
                            <h5 class="alert-heading mb-1 fw-bold">Vendor Minimum Order Requirements Not Met</h5>
                            <p class="mb-1 text-muted">This order does not satisfy the supplier's required thresholds:</p>
                            <ul class="mb-0 ps-3">
                                <li invisible="meets_min_amount">
                                    <strong>Untaxed Amount:</strong> Required
                                    <field name="vendor_min_order_amount" widget="monetary" options="{'currency_field': 'currency_id'}" class="fw-bold" readonly="1"/>
                                    (Current: <field name="amount_untaxed" widget="monetary" options="{'currency_field': 'currency_id'}" class="fw-bold" readonly="1"/>)
                                </li>
                                <li invisible="meets_min_quantity">
                                    <strong>Total Quantity:</strong> Required
                                    <field name="vendor_min_order_quantity" class="fw-bold" readonly="1"/> units
                                    (Current: <field name="total_ordered_qty" class="fw-bold" readonly="1"/> units)
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_filter_inherit_min_order" model="ir.ui.view">
        <field name="name">purchase.order.filter.inherit.min.order</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='draft_rfqs']" position="before">
                <filter name="below_minimums" string="Below Vendor Minimums" domain="[('meets_minimums', '=', False), ('state', 'in', ('draft', 'sent', 'to_approve'))]"/>
                <separator/>
            </xpath>
            <xpath expr="//filter[@name='vendor']" position="after">
                <filter string="Meets Minimums" name="group_by_meets_minimums" domain="[]" context="{'group_by': 'meets_minimums'}"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_view_tree_inherit_min_order" model="ir.ui.view">
        <field name="name">purchase.order.view.list.inherit.min.order</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="meets_minimums" optional="show" widget="boolean" string="Meets Min."/>
            </xpath>
        </field>
    </record>
</odoo>
